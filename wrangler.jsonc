{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "watch-together-app",
  "compatibility_date": "2026-09-26",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "WatchRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WatchRoom"]
    }
  ]
}